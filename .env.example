# Server
PORT=8080
NODE_ENV=development

# SQLite database directory (file: <DATA_DIR>/hobbyland.db)
DATA_DIR=./data

# Default CSV folder for the importer CLI (required unless you pass --dir / --file)
CSV_DIR=/path/to/scraper/output

# Required only for the `hd` (hobbydigi.com) scraper category, which resolves
# each kit's JAN barcode and hg/mg/rg grade from its title. Leave unset to skip
# that category; the other shops do not use it.
DEEPSEEK_API_KEY=
