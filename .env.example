# Server
PORT=8080
NODE_ENV=development

# SQLite database directory (file: <DATA_DIR>/hobbyland.db)
DATA_DIR=./data

# Default CSV folder for the importer CLI (required unless you pass --dir / --file)
CSV_DIR=/path/to/scraper/output

# Resolves each kit's hg/mg/rg grade for the `hd` (hobbydigi.com) scraper
# category and backs the DeepSeek fallback engine of scripts/jev_series.py.
# Leave unset to skip the `hd` category; the other shops do not use it.
DEEPSEEK_API_KEY=

# An OpenRouter API key (https://openrouter.ai/settings/keys) for
# scripts/jev_series.py, which asks the Jev decision model on OpenRouter
# (POST /api/alpha/decisions, model ~typesafe/jev-latest) which Gundam series
# a kit belongs to; usage bills to your OpenRouter account, and when Jev
# cannot answer the script falls back to DEEPSEEK_API_KEY.
JEV_API_KEY=
