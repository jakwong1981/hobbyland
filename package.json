{
  "name": "hobbyland-price-compare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "import:csv": "pnpm --filter backend run import",
    "docker:build": "scripts/docker-build.sh",
    "docker:deploy": "scripts/docker-deploy.sh",
    "scrape": "scripts/scrape-and-import.sh",
    "start": "node backend/dist/index.js",
    "mobile:sync": "pnpm --filter frontend run build && pnpm --filter mobile exec cap sync",
    "mobile:build": "scripts/build-mobile.sh all",
    "mobile:build:android": "scripts/build-mobile.sh android",
    "mobile:build:ios": "scripts/build-mobile.sh ios",
    "mobile:run:android": "scripts/run-android-emulator.sh",
    "mobile:run:ios": "scripts/run-ios-simulator.sh",
    "mobile:open:android": "pnpm --filter mobile exec cap open android",
    "mobile:open:ios": "pnpm --filter mobile exec cap open ios"
  }
}
